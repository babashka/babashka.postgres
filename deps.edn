{:paths ["src" "resources"]
 ;; On babashka the library and babashka.fs are built in; on the JVM they
 ;; come from their repositories.
 :deps {io.github.babashka/ffi
        {:git/url "https://github.com/babashka/ffi"
         :git/sha "5d39a9157ce1f6294d2ff7af84147cb7e568fce1"}
        babashka/fs {:mvn/version "0.5.34"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {cheshire/cheshire {:mvn/version "6.1.0"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
